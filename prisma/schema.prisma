generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("admin")
  /// Consecutive failed logins. Reset to 0 on a successful sign-in.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set when the account trips the lockout threshold; logins are refused until
  /// it passes, whatever the password.
  lockedUntil         DateTime? @map("locked_until")
  /// Last successful sign-in.
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  recurring     RecurringRule[]
  merchantRules MerchantRule[]
  balances      AccountBalance[]
  reserveSteps  ReserveStep[]
  attachments   TransactionAttachment[]
  txnRules      TxnRule[]
  ruleApplyLogs RuleApplyLog[]
  splits        TransactionSplit[]
  recurringDismissals RecurringDismissal[]
  goals         Goal[]
  netWorthItems NetWorthItem[]
  netWorthSnapshots NetWorthSnapshot[]
  brokerConnections BrokerConnection[]
  investmentHoldings InvestmentHolding[]
  investmentTrades InvestmentTrade[]
  investmentDividends InvestmentDividend[]
  investmentCashFlows InvestmentCashFlow[]
  portfolioValues PortfolioValue[]

  @@map("users")
}

// ─── ACCOUNTS ────────────────────────────────────────────────────────
// A real-world money source: a bank account, credit card, cash, etc. Each
// transaction can belong to one. An account has a primary currency but may
// hold transactions in others (e.g. a multi-currency Revolut/Wise account).

model Account {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  name        String
  institution String? // e.g. "Revolut", "Wise", "Amex"
  type        AccountType @default(BANK)
  // Which dashboard scope the account belongs to (personal or business). An
  // explicit column, so the classification survives an account rename.
  biz         AccountBiz  @default(PERSONAL)
  currency    String      @default("EUR") // primary currency
  color       String      @default("#10b981")
  isArchived  Boolean     @default(false) @map("is_archived")
  sortOrder   Int         @default(0) @map("sort_order")
  // Money held back, not drawable — non-null = earmarked, the text says why
  // ("VAT reserve"). Set on /balances; the safe-to-draw tile leaves it out of cash.
  earmark     String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  balances       AccountBalance[]
  goals          Goal[]
  brokerConnections BrokerConnection[]

  @@unique([userId, name])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── CATEGORIES ──────────────────────────────────────────────────────
// A spending/income bucket with an optional monthly cap (the budget). The
// `group` lets the app show a 50/30/20 split without forcing the discipline.

model Category {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  name          String
  group         CategoryGroup @default(WANTS)
  color         String        @default("#10b981") // hex, drives chart + bar colour
  icon          String? // lucide-react icon name
  monthlyBudget Decimal?      @map("monthly_budget") @db.Decimal(12, 2) // null = no cap
  isArchived    Boolean       @default(false) @map("is_archived")
  // Money-movement categories (Transfers, investments, internal top-ups) are
  // excluded from spend/income/budget/report totals so they don't inflate them.
  excludeFromTotals Boolean   @default(false) @map("exclude_from_totals")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  recurring     RecurringRule[]
  merchantRules MerchantRule[]
  splits        TransactionSplit[]

  @@unique([userId, name])
  @@map("categories")
}

// ─── TRANSACTIONS ────────────────────────────────────────────────────
// `amount` is always stored positive; the sign is implied by `type`.
// An imported row lands reviewed=true when a merchant rule or the keyword map
// categorised it, and reviewed=false only when it is uncategorised (or the local-AI
// categoriser guessed it) — those are what the dashboard "to review" inbox shows.

model Transaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  accountId   String?  @map("account_id")
  categoryId  String?  @map("category_id")
  type        TxnType  @default(EXPENSE)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("EUR")
  date        DateTime @db.Date
  /// The period this spend BELONGS to, when that differs from the charge date.
  /// `date` must stay the date the bank charged it: statement reconciliation and the
  /// two-phase import dedup both key on it, so moving it re-imports the row as new.
  /// A flight booked in one month for a trip in the next is the typical case. Null = same
  /// month as `date`, which is the overwhelming majority. All period totals read
  /// COALESCE(accrualDate, date) via `periodWhere()` in src/lib/finance.ts.
  accrualDate DateTime? @map("accrual_date") @db.Date
  merchant    String
  note        String?
  reviewed    Boolean  @default(true)
  recurringId String?  @map("recurring_id")
  /// Where the receipt/invoice for this cost lives (file path, link or ref). Null =
  /// no receipt on file — what /receipts lists for business-scope costs.
  receiptRef   String?       @map("receipt_ref")
  /// F2: what the list SHOWS for this row when a rule renamed it. The raw `merchant`
  /// is a dedup key and must never be rewritten — a rename lands here.
  displayMerchant String?  @map("display_merchant")
  /// F2: free labels set by rules (or by hand). Labels only, never a total.
  tags         String[]      @default([])
  importBatch String?  @map("import_batch")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurring RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  attachments TransactionAttachment[]
  ruleApplyLogs RuleApplyLog[]
  splits      TransactionSplit[]

  @@index([userId, date])
  @@index([userId, accrualDate])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([userId, reviewed])
  @@map("transactions")
}

// ─── ATTACHMENTS (F9) ────────────────────────────────────
// A file stored with a transaction (receipt photo, invoice PDF), in the database —
// the container has no upload volume. Type from magic bytes, 10 MB cap (API). List
// queries must never select `data`.

model TransactionAttachment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  transactionId String   @map("transaction_id")
  filename      String
  mime          String
  sizeBytes     Int      @map("size_bytes")
  sha256        String
  data          Bytes
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, sha256])
  @@index([userId])
  @@map("transaction_attachments")
}

// ─── SPLITS (F3) ─────────────────────────────────────────
// One reconciled transaction broken into parts with their own category. The parent
// keeps date/amount/type/currency/account/merchant; the parts sum to its amount to
// the cent (API + deferred trigger in migration 10) and its categoryId follows the
// largest part. Category breakdowns read parts via expandSplits() (src/lib/splits.ts).

model TransactionSplit {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  transactionId String   @map("transaction_id")
  categoryId    String?  @map("category_id")
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([userId])
  @@map("transaction_splits")
}

// ─── RECURRING RULES ─────────────────────────────────────────────────
// Known repeating bills/subscriptions. Feed the "Upcoming" dashboard
// widget and can be posted as real transactions when they fall due.

model RecurringRule {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  categoryId String?   @map("category_id")
  accountId  String?   @map("account_id")
  merchant   String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("EUR")
  type       TxnType   @default(EXPENSE)
  cadence    Cadence   @default(MONTHLY)
  nextDate   DateTime  @map("next_date") @db.Date
  // Last date the rule can still fire. Null = open-ended. A rule whose income
  // or bill stops (a contract ending, a lease expiring) must stop being
  // projected, or the year-end forecast invents money that never arrives.
  endDate    DateTime? @map("end_date") @db.Date
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, active])
  @@map("recurring_rules")
}

// ─── RECURRING DISMISSALS (F4) ───────────────────────────
// A recurring-detect suggestion the user said "no" to. `key` = the detector's group
// key (account|type|currency|merchant key, src/lib/recurring-detect.ts).

model RecurringDismissal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("recurring_dismissals")
}

// ─── GOALS (F5) ──────────────────────────────────────────
// Display only — never part of safe to draw. `source` picks the progress figure:
// ACCOUNT = latest balance of an earmarked account, RESERVE = reserve level due now
// (reserve_steps), MANUAL = manualAmount. Maths: src/lib/goals.ts.

model Goal {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  name         String
  source       GoalSource @default(MANUAL)
  /// Null on a RESERVE goal = the schedule's final level.
  target       Decimal?   @db.Decimal(12, 2)
  targetDate   DateTime?  @map("target_date") @db.Date
  accountId    String?    @map("account_id")
  manualAmount Decimal?   @map("manual_amount") @db.Decimal(12, 2)
  note         String?
  archived     Boolean    @default(false)
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, archived])
  @@map("goals")
}

enum GoalSource {
  ACCOUNT
  RESERVE
  MANUAL
}

// ─── NET WORTH (F1) ──────────────────────────────────────
// Items = what the bank balances do not hold (car, other assets, debts), valued at
// asOf. Snapshots = one per user and month; trading null = no investment value known
// (never 0); reserve is shown, not subtracted. Maths: src/lib/net-worth.ts.

model NetWorthItem {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  kind      NetWorthItemKind @default(ASSET)
  name      String
  amount    Decimal          @db.Decimal(14, 2)
  currency  String           @default("EUR")
  asOf      DateTime         @map("as_of") @db.Date
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("net_worth_items")
}

enum NetWorthItemKind {
  CAR
  ASSET
  LIABILITY
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  month       DateTime @db.Date
  cash        Decimal  @db.Decimal(14, 2)
  cards       Decimal  @db.Decimal(14, 2)
  trading     Decimal? @db.Decimal(14, 2)
  assets      Decimal  @db.Decimal(14, 2)
  liabilities Decimal  @db.Decimal(14, 2)
  reserve     Decimal? @db.Decimal(14, 2)
  net         Decimal  @db.Decimal(14, 2)
  detail      Json
  estimated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("net_worth_snapshots")
}

// ─── INVESTMENTS ─────────────────────────────────────────
// Read-only broker data: one connection per user and broker. TRADING212 and IBKR are
// filled by POST /api/investments/sync with the credentials from the environment (never
// stored here); MANUAL holds holdings typed on /investments. Money columns on a
// connection, its holdings and its value history are in the connection's
// `baseCurrency`; trades, dividends and cash flows keep the currency they were booked
// in. History rows are keyed by the broker's own id (`externalId`), so a re-sync is a
// no-op. Sync + mapping: src/lib/broker-sync.ts; maths: src/lib/investments.ts.
//
// `accountId` links the connection to an INVESTMENT account: the synced value then
// REPLACES that account's typed balance in net worth instead of being added to it,
// and imported dividend rows are matched on that account (see unmatchedDividends()).

model BrokerConnection {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  broker          Broker
  label           String
  accountId       String?    @map("account_id")
  baseCurrency    String     @default("EUR") @map("base_currency")
  cash            Decimal?   @db.Decimal(14, 2)
  totalValue      Decimal?   @map("total_value") @db.Decimal(14, 2)
  /// The day the broker data describes (an IBKR Flex report is end-of-day).
  asOf            DateTime?  @map("as_of") @db.Date
  status          SyncStatus @default(NEVER)
  lastSyncAt      DateTime?  @map("last_sync_at")
  lastSyncMessage String?    @map("last_sync_message")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  holdings  InvestmentHolding[]
  trades    InvestmentTrade[]
  dividends InvestmentDividend[]
  cashFlows InvestmentCashFlow[]
  values    PortfolioValue[]

  @@unique([userId, broker])
  @@map("broker_connections")
}

/// The positions as of the last sync (replaced on every successful pull).
model InvestmentHolding {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  connectionId  String   @map("connection_id")
  symbol        String
  name          String?
  quantity      Decimal  @db.Decimal(20, 8)
  /// Average cost per share, instrument currency.
  avgCost       Decimal  @map("avg_cost") @db.Decimal(18, 6)
  /// Last price per share, instrument currency.
  price         Decimal? @db.Decimal(18, 6)
  /// Instrument currency.
  currency      String   @default("EUR")
  /// Market value, the connection's base currency.
  value         Decimal? @db.Decimal(14, 2)
  /// Unrealised profit/loss, the connection's base currency.
  unrealisedPnl Decimal? @map("unrealised_pnl") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, symbol])
  @@index([userId])
  @@map("investment_holdings")
}

model InvestmentTrade {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  connectionId String    @map("connection_id")
  externalId   String    @map("external_id")
  symbol       String
  side         TradeSide
  quantity     Decimal   @db.Decimal(20, 8)
  price        Decimal   @db.Decimal(18, 6)
  fees         Decimal   @default(0) @db.Decimal(14, 4)
  currency     String
  executedAt   DateTime  @map("executed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([userId, executedAt])
  @@map("investment_trades")
}

/// A paid dividend. `amount` = the cash actually booked (net of withholding tax).
model InvestmentDividend {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  connectionId   String   @map("connection_id")
  externalId     String   @map("external_id")
  symbol         String
  paidOn         DateTime @map("paid_on") @db.Date
  quantity       Decimal? @db.Decimal(20, 8)
  amount         Decimal  @db.Decimal(14, 2)
  withholdingTax Decimal? @map("withholding_tax") @db.Decimal(14, 2)
  currency       String
  createdAt      DateTime @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([userId, paidOn])
  @@map("investment_dividends")
}

/// Money moved into (DEPOSIT) or out of (WITHDRAWAL) the broker account. `amount` > 0.
model InvestmentCashFlow {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  connectionId String       @map("connection_id")
  externalId   String       @map("external_id")
  date         DateTime     @db.Date
  kind         CashFlowKind
  amount       Decimal      @db.Decimal(14, 2)
  currency     String
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([userId, date])
  @@map("investment_cash_flows")
}

/// The account value per day (base currency) — one row per sync day, plus the daily
/// history an IBKR Flex report carries when the query includes it.
model PortfolioValue {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  connectionId String   @map("connection_id")
  date         DateTime @db.Date
  value        Decimal  @db.Decimal(14, 2)
  cash         Decimal? @db.Decimal(14, 2)
  currency     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@index([userId, date])
  @@map("portfolio_values")
}

enum Broker {
  TRADING212
  IBKR
  MANUAL
}

enum SyncStatus {
  NEVER
  OK
  PARTIAL
  ERROR
}

enum TradeSide {
  BUY
  SELL
}

enum CashFlowKind {
  DEPOSIT
  WITHDRAWAL
}

// ─── MERCHANT RULES ──────────────────────────────────────────────────
// Learned merchant -> category mapping. Created/updated whenever the user
// categorises a transaction, then applied automatically on CSV import.

model MerchantRule {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  matchText  String   @map("match_text") // lowercase substring matched against merchant
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, matchText])
  @@map("merchant_rules")
}

// ─── RULE ENGINE (F2) ────────────────────────────────────
// One table, two tiers. USER = ordered rules from /rules (conditions + actions as
// json, shapes in src/lib/rule-engine.ts). LEARNED = the old merchant_rules rows,
// copied 1:1 by migration 9 (payee.op = word, `matchText` verbatim) and evaluated by
// the UNCHANGED suggestCategoryId matcher, so the move changed no category.
// `learnMerchantRule` now writes LEARNED rows here (upsert on userId + matchText —
// null on USER rows, which Postgres treats as distinct). merchant_rules is
// read-only until it is dropped.

model TxnRule {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  tier           RuleTier @default(USER)
  name           String   @default("")
  priority       Int      @default(0)
  active         Boolean  @default(true)
  stopProcessing Boolean  @default(true) @map("stop_processing")
  matchText      String?  @map("match_text")
  conditions     Json
  actions        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applyLogs RuleApplyLog[]

  @@unique([userId, matchText])
  @@index([userId, tier, priority])
  @@map("txn_rules")
}

enum RuleTier {
  USER
  LEARNED
}

// What one rule apply changed on one row (category / display name / note / tags
// before and after), grouped by `batch` so POST /api/rules/undo/[batch] can put it
// back. Never carries date/amount/type/currency/account/merchant — apply cannot
// touch those.
model RuleApplyLog {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  ruleId        String?   @map("rule_id")
  batch         String
  transactionId String    @map("transaction_id")
  before        Json
  after         Json
  undoneAt      DateTime? @map("undone_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule        TxnRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, batch])
  @@index([transactionId])
  @@map("rule_apply_log")
}

// ─── REAL BALANCES ───────────────────────────────────────────────────
// A statement's closing balance on a date. The account card's net-flow figure is
// NOT a balance (no opening balance); this is. A card's balance is what you owe,
// entered negative. The forecast rolls the latest one forward.

model AccountBalance {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  asOf      DateTime @map("as_of") @db.Date
  balance   Decimal  @db.Decimal(14, 2)
  currency  String   @default("EUR")
  source    String? // statement file name, or "manual"
  // STATEMENT = printed closing balance read off an imported statement
  // (scripts/import-balances.ts); MANUAL = typed on /balances. The auto-fill
  // never overwrites a MANUAL row on the same date.
  origin    BalanceOrigin @default(MANUAL)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOf])
  @@index([userId])
  @@map("account_balances")
}

enum BalanceOrigin {
  STATEMENT
  MANUAL
}

// ─── RESERVE SCHEDULE ────────────────────────────────────────────────
// An optional savings reserve built up in steps, one row per payment step (e.g.
// "after the March invoices, hold 10,000 back"). The safe-to-draw tile subtracts
// `reserveAfter` of the last step whose invoices have been received.

model ReserveStep {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  payDate       DateTime @map("pay_date") @db.Date
  label         String
  invoicesGross Decimal  @map("invoices_gross") @db.Decimal(12, 2)
  reserveAfter  Decimal  @map("reserve_after") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payDate])
  @@map("reserve_steps")
}

// ─── FX RATES ────────────────────────────────────────────────────────
// ECB euro reference rates (public data, not user-scoped). `perEur` = units of
// `currency` per 1 EUR, exactly as the ECB publishes it. Fed by
// scripts/update-fx.mjs and POST /api/fx/update; read by src/lib/fx.ts.

model FxRate {
  currency  String
  date      DateTime @db.Date
  perEur    Decimal  @map("per_eur") @db.Decimal(18, 8)
  source    String   @default("ECB")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([currency, date])
  @@map("fx_rates")
}

