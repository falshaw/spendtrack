# Copy to .env and replace every "change-me" value — the seed, the app and the parser
# refuse to start on these placeholders.
# Generate random values with:  openssl rand -hex 32
# Use hex/alphanumeric values for the passwords: they are embedded in database URLs.

# --- Database (required) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
SPENDTRACK_APP_DB_PASSWORD=change-me-app-db-user

# Host-side connection string for `npm run dev` / Prisma Studio (runtime role, loopback port).
DATABASE_URL=postgresql://spendtrack_app:change-me-app-db-user@127.0.0.1:15432/spendtrack

# --- Auth (required) ---
# At least 32 characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# --- First login (required, used by the one-shot init container) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-12-chars-or-more

# --- Parser sidecar (required) ---
# Shared secret between app and parser, sent as X-Parser-Token. The parser fails closed without it.
PARSER_TOKEN=change-me-parser-token
# For `npm run dev` on the host only (inside Docker the app uses http://spendtrack-parser:8000).
# PARSER_URL=http://127.0.0.1:18000

# --- Receipt reader (all optional) ---
# ollama     = local vision model via Ollama on the host; nothing leaves the machine (default)
# openrouter = optional cloud fallback (free models are rate-limited) — needs the key below
# SPENDTRACK_RECEIPT_ENGINE=ollama
# SPENDTRACK_VLM_MODEL=qwen2.5vl:7b
# SPENDTRACK_OLLAMA_URL=http://host.docker.internal:11434
# SPENDTRACK_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_API_KEY=

# --- Ports (optional, all bound to 127.0.0.1) ---
# SPENDTRACK_PORT=3000
# SPENDTRACK_PARSER_PORT=18000
# SPENDTRACK_DB_PORT=15432
# ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000

# --- Safe-to-draw tile (optional) ---
# Share of each unpaid business invoice set aside for tax, monthly living budget (≈EUR),
# and the date from which received invoices count toward the reserve steps.
# SAFE_TO_DRAW_TAX_RATE=0.25
# SAFE_TO_DRAW_MONTHLY_BUDGET=2000
# SAFE_TO_DRAW_SINCE=2000-01-01

# --- Import (optional) ---
# Your surname as printed on card statements, so a line that is only the cardholder
# name never wins over the real merchant when overlapping statements are merged.
# CARDHOLDER_NAME=

# --- Investments (all optional, read-only) ---
# Leave these empty and /investments still works with manual holdings (and the demo data);
# each broker shows "not connected". Credentials are only read from the environment and
# are never stored in the database. The sync only downloads data — it never places orders.
#
# Trading 212: Settings → API → generate a key with READ-ONLY permissions (account data,
# portfolio, history). Key + secret are sent as HTTP Basic auth; an older key without a
# secret is sent on its own. TRADING212_ENV=demo uses the practice account.
# TRADING212_API_KEY=
# TRADING212_API_SECRET=
# TRADING212_ENV=live
#
# Interactive Brokers: Client Portal → Performance & Reports → Flex Queries. Create an
# Activity Flex Query (XML) with the sections Account Information, Cash Report, Open
# Positions, Trades, Cash Transactions and (for the value history) Net Asset Value /
# Equity Summary in Base; note its query id. Then enable the Flex Web Service there to get
# a token. The report is end-of-day, so today's trades appear tomorrow.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=
#
# The broker credentials belong to one person. On an install with more than one user,
# only this user may run the sync (a single-user install needs nothing here).
# BROKER_SYNC_USER_EMAIL=
